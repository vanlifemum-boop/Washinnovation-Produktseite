---
import { getCollection } from "astro:content";
import Basis from "../../layouts/Basis.astro";
import ProduktKarte from "../../components/ProduktKarte.astro";
import Zaehler from "../../components/Zaehler.astro";
import Bildflaeche from "../../components/Bildflaeche.astro";
import { AKTIVE_SPRACHEN, uebersetzer, pfad, datei, type Sprache } from "../../i18n/ui";
import { wasserzahl, standLesbar, text } from "../../data/daten";

export function getStaticPaths() {
  return AKTIVE_SPRACHEN.map((lang) => ({ params: { lang } }));
}

const sprache = Astro.params.lang as Sprache;
const t = uebersetzer(sprache);

// Zwei belegte Zahlen statt allgemeiner Sätze. Fehlt eine in wasserzahlen.json,
// fällt sie hier stillschweigend weg — der Abschnitt bleibt trotzdem heil.
const startZahlen = ["ohne-trinkwasser", "pro-kopf"]
  .map((id) => wasserzahl(id))
  .filter((z) => z !== undefined);

const alle = await getCollection("produkte");
const produkte = alle
  .filter((p) => p.id.startsWith(`${sprache}/`))
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---

<Basis sprache={sprache} titel={t("meta.marke")} seitenpfad="" hero={true}>
  <!-- ============================ Hero ============================ -->
  <section class="hero" id="hero">
    <div class="hero-buehne">
      <div class="hero-klebrig">
        <canvas></canvas>

        {/* Die Handpumpe: zwei Ebenen desselben Bildes (eine Datei, ein Abruf).
            Der Körper ist unbeweglich und trägt die Düse — data-duese sagt, wo
            am Bild sie sitzt (in Prozent der Bildmaße); die Tropfen-Ebene liest
            das aus und lässt die Tropfen genau dort austreten. Der blaue
            Druckkopf liegt darüber und sinkt beim Scrollen ein (pumpe.js).
            Die Quelle bleibt bewusst am Körper: Die Düse pumpt nicht mit. */}
        <div class="hero-produkt">
          <img
            class="hero-produkt__koerper"
            src={datei("bilder/produkte/handy-shower-foto.png")}
            alt="Handy Shower"
            data-tropfen-quelle
            data-duese="40.6,98"
            fetchpriority="high"
          />
          <img
            class="hero-produkt__kopf"
            src={datei("bilder/produkte/handy-shower-foto.png")}
            alt=""
            aria-hidden="true"
            data-pumpen-kopf
          />
        </div>

        <div class="hero-inhalt">
          <div class="behaelter">
            <p class="augenbraue" style="color:#9ed2f5">{t("meta.claim")}</p>
            <h1 class="display">
              {t("start.hero.zeile1")}
              <span class="hero-zeile2">{t("start.hero.zeile2")}</span>
            </h1>
            <p class="lead">{t("start.hero.text")}</p>
            <div class="knopfreihe">
              <a class="btn" href={pfad(sprache, "produkte")}>{t("start.hero.cta")}</a>
              <a class="btn btn--rand" href={pfad(sprache, "1plus1")}>{t("start.hero.cta2")}</a>
            </div>
          </div>
        </div>
        <p class="scrollhinweis">{t("start.hero.scrollhinweis")}</p>
      </div>
    </div>
  </section>

  <!-- =========================== Problem =========================== -->
  <section class="sek sek--weiss">
    <div class="behaelter">
      <div class="sek-kopf schmal">
        <h2 class="gross" data-reveal>{t("start.problem.titel")}</h2>
        <p class="lead" data-reveal>{t("start.problem.text")}</p>
      </div>
      <div class="raster raster--3">
        <div class="karte" data-reveal>
          <h3>{t("start.problem.punkt1.titel")}</h3>
          <p class="leise">{t("start.problem.punkt1.text")}</p>
        </div>
        <div class="karte" data-reveal>
          <h3>{t("start.problem.punkt2.titel")}</h3>
          <p class="leise">{t("start.problem.punkt2.text")}</p>
        </div>
        <div class="karte" data-reveal>
          <h3>{t("start.problem.punkt3.titel")}</h3>
          <p class="leise">{t("start.problem.punkt3.text")}</p>
        </div>
      </div>

      {startZahlen.length > 0 && (
        <div class="raster raster--2" style="margin-top:clamp(28px,4vw,44px)">
          {startZahlen.map((z) => (
            <div class="karte zahlkarte" data-reveal>
              <p class="zahl">{z.wert}</p>
              <h3>{text(z.titel, sprache)}</h3>
              {z.erlaeuterung && <p class="leise">{text(z.erlaeuterung, sprache)}</p>}
              <p class="beleg">{z.quelle} · {t("wasser.stand")} {standLesbar(z.stand)}</p>
            </div>
          ))}
        </div>
      )}

      <div class="knopfreihe" data-reveal>
        <a class="btn btn--rand" href={pfad(sprache, "wasser")}>{t("start.problem.zahlen.link")}</a>
      </div>
    </div>
  </section>

  <!-- =========================== Produkte ========================== -->
  <section class="sek sek--schaum">
    <div class="behaelter">
      <div class="sek-kopf schmal">
        <p class="augenbraue" data-reveal>{t("nav.produkte")}</p>
        <h2 class="gross" data-reveal>{t("start.produkte.titel")}</h2>
        <p class="lead" data-reveal>{t("start.produkte.text")}</p>
      </div>
      <div class="raster raster--4">
        {produkte.map((p) => (
          <ProduktKarte
            sprache={sprache}
            name={p.data.name}
            slug={p.data.slug}
            kurz={p.data.kurz}
            preis={p.data.preis}
            bild={p.data.bild}
          />
        ))}
      </div>
      <div class="knopfreihe" data-reveal>
        <a class="btn btn--rand" href={pfad(sprache, "produkte")}>{t("start.produkte.alle")}</a>
      </div>
    </div>
  </section>

  <!-- ============================ Zähler =========================== -->
  <Zaehler sprache={sprache} />

  <!-- ============================ Einsatz ========================== -->
  <section class="sek sek--weiss">
    <div class="behaelter">
      <div class="sek-kopf schmal">
        <h2 class="gross" data-reveal>{t("start.einsatz.titel")}</h2>
      </div>
      <div class="raster raster--2" style="align-items:start">
        <div data-reveal>
          <!-- Bewegt sich beim Scrollen etwas langsamer als der Text daneben -->
          <div data-parallax="0.05">
            <Bildflaeche
              bild="bilder/produkte/einsatz.svg"
              alt={t("platzhalter.bild")}
              ripple={true}
              platzhalter={true}
              hinweis={t("platzhalter.bild")}
            />
          </div>
        </div>
        <div class="raster" style="gap:18px">
          <div class="karte" data-reveal>
            <h3>{t("start.einsatz.vanlife")}</h3>
            <p class="leise">{t("start.einsatz.vanlife.text")}</p>
          </div>
          <div class="karte" data-reveal>
            <h3>{t("start.einsatz.reise")}</h3>
            <p class="leise">{t("start.einsatz.reise.text")}</p>
          </div>
          <div class="karte" data-reveal>
            <h3>{t("start.einsatz.festival")}</h3>
            <p class="leise">{t("start.einsatz.festival.text")}</p>
          </div>
          <div class="karte" data-reveal>
            <h3>{t("start.einsatz.hilfe")}</h3>
            <p class="leise">{t("start.einsatz.hilfe.text")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== CTA ============================ -->
  <section class="sek sek--eis">
    <div class="behaelter schmal" style="text-align:center">
      <h2 class="gross" data-reveal>{t("start.cta.titel")}</h2>
      <p class="lead" data-reveal style="margin-inline:auto">{t("start.cta.text")}</p>
      <div class="knopfreihe" style="justify-content:center" data-reveal>
        <a class="btn" href={pfad(sprache, "bestellen")}>{t("start.cta.button")}</a>
      </div>
    </div>
  </section>

  <Fragment slot="skripte">
    <script is:inline src={datei("effekte/pumpe.js")}></script>
    <script is:inline src={datei("effekte/hero-szene.js")}></script>
    <script is:inline src={datei("effekte/vendor/lenis.min.js")}></script>
    <script is:inline define:vars={{ }}>
      // Der Hero wird prozedurenbasiert gezeichnet — keine Bilddateien nötig.
      // Sobald echte Clips vorliegen: `render` durch `framePath` ersetzen.
      window.SCRUB_SECTIONS = [
        { section: "#hero", frameCount: 180, bg: "#03192c", render: window.WASSER_SZENE },
      ];
    </script>
    <script is:inline src={datei("effekte/scroll-cinematic.js")}></script>
  </Fragment>
</Basis>
