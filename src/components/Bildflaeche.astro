---
import { datei } from "../i18n/ui";

interface Props {
  /** Pfad unter public/, z. B. "bilder/produkte/pocket-bath-plus.jpg" */
  bild: string;
  alt: string;
  /** Wasser-Ripple auf der Fläche aktivieren */
  ripple?: boolean;
  klasse?: string;
}

/* Hier saß einmal ein „Platzhalter“-Fähnchen über dem Bild, für die Zeit ohne
   echte Produktfotos. Alle sieben Sets haben inzwischen ihr Katalogfoto, und
   das Fähnchen zeigte nur noch auf der Grafik im Hero — es ist ersatzlos
   entfallen. */
const { bild, alt, ripple = false, klasse = "" } = Astro.props;
---

<figure class={`bildflaeche ${klasse}`} data-ripple={ripple ? "" : undefined}>
  <img src={datei(bild)} alt={alt} loading="lazy" decoding="async" />
</figure>
